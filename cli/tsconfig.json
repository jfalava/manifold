{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["bun-types", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "package.json", "src/**/*.ts"]
}

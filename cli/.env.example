# CLI credentials (copy to cli/.env — gitignored).
# Resolve order: flag → MANIFOLD_* env name from this file / process env.
# Deploy/Worker secrets live in iac/.env instead.

# Manifold API (ops, reconcile, registry). Sign in once with
# `manifold login manifold`; the session is kept in the OS keychain and
# refreshes automatically.
MANIFOLD_API_ORIGIN=

# AniList (anilist login, migrations, reconcile, registry import/prefill)
# Register http://127.0.0.1:8767/callback on a separate authorization-code CLI client.
# Do not reuse the shared implicit clients: 49218 (CLI app, localhost callback)
# or the Worker app 49060 (PIN flow).
MANIFOLD_ANILIST_CLIENT_ID=
MANIFOLD_ANILIST_CLIENT_SECRET=

# MyAnimeList (mal login, migrate wipe-mal)
# Register http://127.0.0.1:8766/callback on a separate CLI OAuth client.
MANIFOLD_MAL_CLIENT_ID=
MANIFOLD_MAL_CLIENT_SECRET=

# MangaDex password grant (stale-status, unfollow-dropped, al2md, md2al)
MANIFOLD_MANGADEX_CLIENT_ID=
MANIFOLD_MANGADEX_CLIENT_SECRET=
MANIFOLD_MANGADEX_USERNAME=
MANIFOLD_MANGADEX_PASSWORD=

# Comix registry prefill (optional seeds)
# MANIFOLD_COMIX_COOKIES=
# MANIFOLD_COMIX_CF_CLEARANCE=
# MANIFOLD_COMIX_SESSION=
# MANIFOLD_COMIX_CHROME_CDP_URL=

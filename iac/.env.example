# Alchemy deploy-time configuration (copy to iac/.env — gitignored).
# Every Manifold config/secret uses the MANIFOLD_ prefix.
# CLI credentials live in cli/.env instead.

# ── Plain vars (public, not sensitive) ──────────────────────────────
# The exact public URL of the router Worker, with no trailing path.
MANIFOLD_OAUTH_REDIRECT_BASE_URL=
# Paperback source clients (SyncApi OAuth):
# https://manifold.jfa.dev/api/v1/auth/anilist/callback
# https://manifold.jfa.dev/api/v1/auth/mal/callback
MANIFOLD_ANILIST_CLIENT_ID=
MANIFOLD_MAL_CLIENT_ID=
# MangaDex personal client — https://mangadex.org/settings
MANIFOLD_MANGADEX_CLIENT_ID=

# ── Secrets (account Secrets Store, bound per worker) ───────────────
# Each set entry provisions/rotates that secret at deploy time; names
# without a value must already exist in the store. `alchemy dev` reads
# the same entries as plain local secret values.

# SyncApi:
MANIFOLD_TOKEN=
MANIFOLD_OAUTH_TOKEN_ENCRYPTION_SECRET=
MANIFOLD_ANILIST_CLIENT_SECRET=
MANIFOLD_MAL_CLIENT_SECRET=
MANIFOLD_MANGADEX_CLIENT_SECRET=
MANIFOLD_MANGADEX_USERNAME=
MANIFOLD_MANGADEX_PASSWORD=

# Admin analytics GraphQL token (Cloudflare account API).
MANIFOLD_ADMIN_PANEL_ANALYTICS_API=

# Independent archive directory, ideally on a backup disk or backed-up filesystem.
# Defaults to .backups/ in the checkout. Files contain secrets and use mode 0600.
MANIFOLD_BACKUP_DIR=
# Optional API base URL for the deployment backup gate.
MANIFOLD_API_ORIGIN=https://manifold.jfa.dev/api

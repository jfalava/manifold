# Alchemy deploy-time configuration (copy to iac/.env — gitignored).
# Every entry appears exactly once: plain vars for public identifiers,
# ALCHEMY_SECRET_ entries provisioned into the account Secrets Store.

# ── Plain vars (public, not sensitive) ──────────────────────────────
# The exact public URL of the router Worker, with no trailing path.
OAUTH_REDIRECT_BASE_URL=
# Paperback source clients (SyncApi OAuth):
# https://manifold.jfa.dev/api/v1/auth/anilist/callback
# https://manifold.jfa.dev/api/v1/auth/mal/callback
ANILIST_CLIENT_ID=
MAL_CLIENT_ID=
# MangaDex personal client — https://mangadex.org/settings
MANGADEX_CLIENT_ID=
# Admin app: dedicated AniList app for the browser code flow.
# Register redirect URI: https://manifold.jfa.dev/admin/api/anilist/callback
ADMIN_ANILIST_CLIENT_ID=

# ── Secrets (account Secrets Store, bound per worker) ───────────────
# Each entry provisions or rotates that secret at deploy time; names
# without an entry must already exist in the store. `alchemy dev`
# reads the same entries as plain local secret values.

# SyncApi:
ALCHEMY_SECRET_MANIFOLD_TOKEN=      # bearer auth for /api/v1/*
ALCHEMY_SECRET_OAUTH_TOKEN_ENCRYPTION_SECRET=   # DO token encryption
ALCHEMY_SECRET_ANILIST_CLIENT_SECRET=    # paperback AniList client
ALCHEMY_SECRET_MAL_CLIENT_SECRET=        # may stay empty for PKCE-only
ALCHEMY_SECRET_MANGADEX_CLIENT_SECRET=
ALCHEMY_SECRET_MANGADEX_USERNAME=
ALCHEMY_SECRET_MANGADEX_PASSWORD=

# Admin app (AniList → MangaDex migration): authorization-code flow. The
# secret stays server-side and only performs the token exchange; AniList
# reads themselves happen browser-side with the exchanged token.
ALCHEMY_SECRET_ADMIN_ANILIST_CLIENT_SECRET=

# ── CLI-only (local, never deployed — iac/.env is gitignored) ──────
# MangaDex/AniList for the CLI resolve the same way: bare name or
# ALCHEMY_SECRET_ prefix both work (flag > bare > ALCHEMY_SECRET_).
# ANILIST_TOKEN / ALCHEMY_SECRET_ANILIST_TOKEN
# MANIFOLD_TOKEN / ALCHEMY_SECRET_MANIFOLD_TOKEN
# MANGADEX_TOKEN / ALCHEMY_SECRET_MANGADEX_TOKEN (or the 4 password-grant vars above)
# Comix: registry comix launches a dedicated Chrome profile (~/.manifold/comix-chrome).
# The harvested jar lives in Bun.secrets until cf_clearance expires.
# Optional seed cookies (injected into the view, never replayed via fetch):
# COMIX_COOKIES / ALCHEMY_SECRET_COMIX_COOKIES
# COMIX_CF_CLEARANCE / ALCHEMY_SECRET_COMIX_CF_CLEARANCE
# COMIX_SESSION / ALCHEMY_SECRET_COMIX_SESSION
# COMIX_CHROME_CDP_URL  ws://127.0.0.1:9222/devtools/browser/...

##

ALCHEMY_SECRET_ADMIN_PANEL_ANALYTICS_API=

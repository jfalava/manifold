# Alchemy deploy-time configuration (copy to iac/.env — gitignored).
# Every Manifold config/secret uses the MANIFOLD_ prefix.
# CLI credentials live in cli/.env instead.

# ── Deploy channel ──────────────────────────────────────────────────
# The only value `bun run deploy` consumes: which Paperback catalog path
# and tracker id to stage (and plan). Process env ENV wins.
#
#   manifold-stable → /extensions/0.9/stable + extension id MANIFOLD
#   manifold-beta   → /extensions/0.9/beta   + extension id MANIFOLD-beta
#
# Staging is per-channel and non-destructive: deploying beta leaves the
# previously staged stable assets in place (and vice versa).
ENV=manifold-beta

# ── Everything else is Secrets Store bindings ───────────────────────
# The redirect base URL, GitHub access gate, AniList/MAL/MangaDex client
# IDs, and every secret are bound as `secrets_store_secret` descriptors
# from the account store (default_secrets_store). Values are created and
# rotated manually in Cloudflare outside this deployment; the matching
# records must exist, active with Workers scope. See iac/README.md for
# the binding table, local development, and migration notes.

# ── Optional backup script settings (not used by deploy) ────────────
# Directory for local copies written by `bun run backup`.
# Defaults to .backups/ in the checkout. Snapshots include encrypted OAuth tokens.
MANIFOLD_BACKUP_DIR=
# API base URL for `bun run backup` (default production API).
MANIFOLD_API_ORIGIN=https://manifold.jfa.dev/api

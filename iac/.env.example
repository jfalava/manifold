# Alchemy deploy-time configuration (copy to iac/.env — gitignored).
# Every Manifold config/secret uses the MANIFOLD_ prefix.
# CLI credentials live in cli/.env instead.

# ── Deploy channel ──────────────────────────────────────────────────
# Controls which Paperback catalog path and tracker id `bun run deploy`
# (and `bun run build:catalog` / `plan`) stage into the Worker assets.
# Process env ENV wins over this file when both are set.
#
#   manifold-stable → /extensions/0.9/stable + extension id MANIFOLD
#   manifold-beta   → /extensions/0.9/beta   + extension id MANIFOLD-beta
#
# Staging is per-channel and non-destructive: deploying beta leaves the
# previously staged stable assets in place (and vice versa).
ENV=manifold-beta

# ── Plain vars (public, not sensitive) ──────────────────────────────
# The exact public URL of the router Worker, with no trailing path.
MANIFOLD_OAUTH_REDIRECT_BASE_URL=
# GitHub OAuth app used by the Manifold tracker and CLI clients:
# https://manifold.jfa.dev/api/v1/oauth/github/callback
MANIFOLD_GITHUB_CLIENT_ID=
# Numeric GitHub user ID allowed to access this personal Manifold instance.
MANIFOLD_GITHUB_ALLOWED_USER_ID=
# Paperback source clients (SyncApi upstream OAuth):
# https://manifold.jfa.dev/api/v1/auth/anilist/callback
# https://manifold.jfa.dev/api/v1/auth/mal/callback
MANIFOLD_ANILIST_CLIENT_ID=
MANIFOLD_MAL_CLIENT_ID=
# MangaDex personal client — https://mangadex.org/settings
MANIFOLD_MANGADEX_CLIENT_ID=

# ── Secrets (account Secrets Store, bound per worker) ───────────────
# Secret values never live in this file. They are created and rotated
# manually in the Cloudflare Secrets Store (default_secrets_store); the
# deployment only emits `secrets_store_secret` bindings to the existing
# records. Names must already exist with active status and Workers scope:
#
#   MANIFOLD_TOKEN, MANIFOLD_OAUTH_TOKEN_ENCRYPTION_SECRET,
#   MANIFOLD_GITHUB_CLIENT_SECRET, MANIFOLD_ANILIST_CLIENT_SECRET,
#   MANIFOLD_MAL_CLIENT_SECRET, MANIFOLD_MANGADEX_CLIENT_SECRET,
#   MANIFOLD_MANGADEX_USERNAME, MANIFOLD_MANGADEX_PASSWORD,
#   MANIFOLD_ADMIN_PANEL_ANALYTICS_API
#
# See iac/README.md for the binding table, local-development notes, and
# the one-time migration procedure from Alchemy-managed secrets.

# Optional directory for local copies written by `bun run backup`.
# Defaults to .backups/ in the checkout. Snapshots include encrypted OAuth tokens.
MANIFOLD_BACKUP_DIR=
# Optional API base URL for `bun run backup` (default production API).
MANIFOLD_API_ORIGIN=https://manifold.jfa.dev/api

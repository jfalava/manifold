---
import DocsLayout from "../layouts/DocsLayout.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Code } from "../components/ui/code";
import { LinkButton } from "../components/ui/link-button";
import { Tabs, TabItem } from "../components/ui/tabs";
import { config } from "virtual:nimbus/config";
import { withBase } from "../lib/urls";
import bodyFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import headingFont from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";

const stableRepoUrl = "https://manifold.jfa.dev/paperback/extensions/0.9/stable";
const betaRepoUrl = "https://manifold.jfa.dev/paperback/extensions/0.9/beta";
const stableAddRepo = `paperback://addRepo?displayName=${encodeURIComponent("Manifold (Stable)")}&url=${encodeURIComponent(stableRepoUrl)}`;
const betaAddRepo = `paperback://addRepo?displayName=${encodeURIComponent("Manifold (Beta)")}&url=${encodeURIComponent(betaRepoUrl)}`;

const registryCommand = `manifold login manifold
manifold pas5 create \\
  --source registry --limit 10 \\
  --tabs none \\
  --out ./Paperback-Registry-10.pas5`;
const anilistCommand = `manifold login manifold
manifold login anilist
manifold pas5 create \\
  --source anilist --limit 10 \\
  --out ./Paperback-AniList-10.pas5`;

const features = [
  {
    icon: "ph:archive",
    title: "Create Paperback backups",
    body: "Generate PAS5 archives from AniList or your canonical registry. Filter provider attachments in an existing backup offline.",
  },
  {
    icon: "ph:arrows-left-right",
    title: "Move between providers",
    body: "Migrate manga lists between AniList and MangaDex, or from AniList to MyAnimeList. Review the plan before applying changes.",
  },
  {
    icon: "ph:database",
    title: "Maintain the registry",
    body: "Import AniList list state and backfill verified MyAnimeList, MangaDex, and Comix links on canonical entries.",
  },
  {
    icon: "ph:git-diff",
    title: "Inspect drift and queued writes",
    body: "Compare provider lists with registry state, inspect pending operations, retry failures, and drain AniList writes locally.",
  },
];

const references = [
  {
    title: "Authentication",
    body: "Sign in with GitHub and save your Manifold session in the OS keychain.",
    href: "/cli/login/manifold/",
  },
  {
    title: "PAS5 tools",
    body: "Creation, filtering, status tabs, and restore precautions.",
    href: "/cli/pas5/",
  },
  {
    title: "Registry import",
    body: "Snapshot your live AniList manga list into the canonical registry.",
    href: "/cli/registry/import/",
  },
  {
    title: "AniList to MangaDex",
    body: "Preview and apply a cross-provider library migration.",
    href: "/cli/migrate/anilist-to-mangadex/",
  },
  {
    title: "Pending operations",
    body: "Inspect queued writes before retrying or draining them.",
    href: "/cli/ops/pending/",
  },
  {
    title: "Reconciliation",
    body: "Find differences between provider lists and registry state.",
    href: "/cli/reconcile-diff/",
  },
];
---

<DocsLayout
  title={config.title}
  description={config.description}
  sidebar={false}
  headings={false}
  breadcrumbs={[]}
  prevNext={{}}
  mode="custom"
  collection="docs"
  head={[bodyFont, headingFont].map((href) => ({
    tag: "link",
    attrs: { rel: "preload", href, as: "font", type: "font/woff2", crossorigin: "anonymous" },
  }))}
>
  <div data-pagefind-body>
    <section aria-labelledby="paperback-install-title" class="border-b border-border">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 id="paperback-install-title" class="text-base font-semibold text-foreground">
            Install in Paperback
          </h2>
          <p class="mt-1 max-w-sm text-sm leading-relaxed text-muted-foreground">
            Open these links on a device with Paperback installed.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <LinkButton href={stableAddRepo} variant="primary" icon>
            Add Stable to Paperback
          </LinkButton>
          <LinkButton href={betaAddRepo} variant="secondary" icon>
            Add Beta to Paperback
          </LinkButton>
        </div>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto max-w-5xl px-6 pb-16 pt-16 sm:pt-24">
        <h1 class="hero-title max-w-3xl text-balance text-foreground">
          Your library. One registry.
        </h1>
        <p class="mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground">
          Generate Paperback backups, migrate provider lists, and maintain your
          canonical registry from the terminal.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <LinkButton
            href={withBase("/cli/#installation")}
            variant="primary"
            size="lg"
            icon
          >
            Get started
          </LinkButton>
          <LinkButton
            href={withBase("/cli/#command-reference")}
            variant="secondary"
            size="lg"
          >
            CLI reference
          </LinkButton>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-title text-foreground">Preview a backup</h2>
      <p class="mt-4 max-w-2xl text-pretty leading-relaxed text-muted-foreground">
        Sign in, choose your source, and review a limited Paperback archive.
        Repeat with <code>--apply</code> to write the file.
      </p>
      <Tabs syncKey="pas5-source" class="backup-tabs mt-6 max-w-2xl">
        <TabItem label="Registry">
          <Code code={registryCommand} lang="sh" />
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            <code>--tabs none</code> includes eligible titles without list
            status. Skipped entries among the first ten active rows can leave
            fewer than ten titles.
          </p>
        </TabItem>
        <TabItem label="AniList" hidden>
          <Code code={anilistCommand} lang="sh" />
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            <a
              href={withBase("/cli/login/anilist/")}
              class="text-primary underline underline-offset-2 hover:decoration-2"
            >
              Set up AniList login
            </a>{" "}
            first. This example keeps the default status tabs and limits newly
            generated eligible titles to ten.
          </p>
        </TabItem>
      </Tabs>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-16">
      <h2 class="section-title text-foreground">What it does</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {features.map((feature) => (
          <article class="rounded-lg bg-card p-5 shadow-sm ring ring-border">
            <Icon
              name={feature.icon}
              class="mb-2.5 block h-6 w-6 text-primary"
            />
            <h3 class="m-0 text-base font-semibold leading-snug text-foreground">
              {feature.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              {feature.body}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-24">
      <h2 class="section-title text-foreground">Explore the CLI</h2>
      <ul class="mt-6 grid list-none gap-x-8 gap-y-4 p-0 sm:grid-cols-2">
        {references.map((reference) => (
          <li class="m-0 border-t border-border pt-3">
            <a
              href={withBase(reference.href)}
              class="font-semibold text-foreground no-underline hover:text-primary"
            >
              {reference.title}
            </a>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
              {reference.body}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</DocsLayout>

<style>
  /* Reserve the trigger row before Tabs synthesizes its buttons. */
  :global(.backup-tabs [role="tablist"]) {
    min-height: 2.5625rem;
  }

  .hero-title {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: var(--nb-h1-weight);
    letter-spacing: var(--nb-h1-tracking);
    line-height: 1.05;
    text-transform: var(--nb-h1-transform);
  }

  .section-title {
    font-size: var(--nb-h2-size);
    font-weight: var(--nb-h2-weight);
    letter-spacing: var(--nb-h2-tracking);
    line-height: 1.1;
    text-transform: var(--nb-h2-transform);
  }
</style>

---
/**
 * PackageLicenses — thank-you note plus one exclusive disclosure per
 * open-source package (name, license badge, license excerpt, full-text link).
 * Data comes from src/lib/licenses.ts, written by `bun run licenses`.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Badge } from "@/components/ui/badge";
import { LinkButton } from "@/components/ui/link-button";
import { packages } from "@/lib/licenses";
---

<section
  class="my-6 rounded-lg bg-card px-6 pt-6 pb-2 shadow-sm ring ring-border"
  aria-label="Open-source packages and their licenses"
>
  <p class="m-0 pb-6 text-center font-serif text-muted-foreground">
    Manifold is built with the help of these amazing open-source projects. I am
    incredibly grateful to the OSS community for their contributions!
  </p>
  <div class="pt-4">
    {packages.map((pkg) => (
      <details
        name="package-licenses"
        class="group border-b border-border last:border-b-0"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-4 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ring [&::-webkit-details-marker]:hidden">
          <span class="flex min-w-0 flex-wrap items-center gap-2">
            <span class="font-medium [overflow-wrap:anywhere]">{pkg.name}</span>
            <Badge text={pkg.license} />
          </span>
          <Icon
            name="ph:caret-down"
            class="size-4.5 shrink-0 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
            aria-hidden="true"
          />
        </summary>
        <div class="flex flex-col items-start gap-4 pb-6">
          <p class="m-0 text-sm leading-normal whitespace-pre-wrap text-muted-foreground italic [overflow-wrap:anywhere]">
            {pkg.excerpt || "See the full license for this project's terms."}
          </p>
          <LinkButton
            href={pkg.licenseUrl}
            variant="secondary"
            size="sm"
            target="_blank"
            rel="noopener noreferrer"
          >
            {pkg.licenseUrl.endsWith("/package.json")
              ? "View license declaration"
              : "View full license"}
            <Icon name="ph:arrow-up-right" class="size-4" aria-hidden="true" />
          </LinkButton>
        </div>
      </details>
    ))}
  </div>
</section>

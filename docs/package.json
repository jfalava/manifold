{
  "name": "@manifold/docs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun lint:fix",
    "dev": "astro dev --host",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "bun run lint:oxlint && bun run lint:astro && bun run lint:docs",
    "lint:astro": "eslint \"src/**/*.astro\"",
    "lint:astro:fix": "eslint \"src/**/*.astro\" --fix",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "lint:fix": "bun run lint:oxlint:fix && bun run lint:astro:fix && bun run lint:docs:fix",
    "lint:oxlint": "astro sync && oxlint src --ignore-pattern '**/*.astro'",
    "lint:oxlint:fix": "astro sync && oxlint src --ignore-pattern '**/*.astro' --fix",
    "predeploy": "astro check && astro build",
    "prepreview:cf": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.14.1",
    "@fontsource/google-sans-code": "catalog:fonts",
    "@fontsource/ibm-plex-sans": "catalog:fonts",
    "@fontsource/zilla-slab": "catalog:fonts",
    "@iconify-json/ph": "1.2.2",
    "@manifold/json": "workspace:*",
    "astro": "~7.3.3",
    "astro-icon": "1.2.0",
    "astro-og-canvas": "0.13.2",
    "canvaskit-wasm": "0.42.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler": "4.0.0",
    "@oxlint/plugins": "catalog:build",
    "@tailwindcss/vite": "catalog:styling",
    "@typescript-eslint/parser": "8.70.0",
    "cross-spawn": "7.0.6",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "oxlint": "catalog:build",
    "pagefind": "1.5.2",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "satteri": "0.10.5",
    "satteri-source-parser": "npm:satteri@0.10.5",
    "tailwindcss": "catalog:styling",
    "typescript": "6.0.2"
  },
  "optionalDependencies": {
    "@bruits/satteri-darwin-arm64": "0.10.5",
    "@bruits/satteri-linux-arm64-gnu": "0.10.5",
    "@bruits/satteri-linux-x64-gnu": "0.10.5",
    "@bruits/satteri-win32-x64-msvc": "0.10.5"
  }
}

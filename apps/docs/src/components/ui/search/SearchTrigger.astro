---
/** Button that opens the search dialog. Cmd+K on macOS, Ctrl+K elsewhere. */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
---

<button
  data-search-trigger
  type="button"
  class="inline-flex items-center gap-1.5 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
  aria-label="Open search"
  aria-keyshortcuts="Control+K"
>
  <Icon name="ph:magnifying-glass" class="size-4" />
  <span class="hidden sm:inline text-xs font-medium">Search</span>
  <kbd class="hidden sm:inline-flex items-center gap-0.5 text-[10px] font-medium leading-none text-muted-foreground">
    <span data-shortcut-key>Ctrl</span>
    <span>K</span>
  </kbd>
</button>

<script>
  import "./search-trigger.client";
</script>

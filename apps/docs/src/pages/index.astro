---
import DocsLayout from "../layouts/DocsLayout.astro";
import { Code } from "../components/ui/code";
import { config } from "virtual:nimbus/config";
import {
  getBreadcrumbs,
  getPrevNext,
  getSidebar,
} from "@cloudflare/nimbus-docs";
import {
  withBaseBreadcrumbs,
  withBasePrevNext,
  withBaseSidebar,
} from "../lib/urls";

const rawSidebar = await getSidebar("/", { collection: "docs" });
const sidebar = withBaseSidebar(rawSidebar);
const breadcrumbs = withBaseBreadcrumbs(
  await getBreadcrumbs("/", { collection: "docs" }),
);
const prevNext = withBasePrevNext(
  await getPrevNext("/", { sidebarTree: rawSidebar }),
);
const baseUrl = import.meta.env.BASE_URL;
const sourceRepoUrl =
  "https://manifold.jfa.dev/paperback/extensions/0.9/stable/";
---

<DocsLayout
  title={config.title}
  description={config.description}
  sidebar={sidebar}
  headings={false}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  collection="docs"
>
  <Fragment slot="page-title">
    <p
      class="mt-6 font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase"
    >
      Start here
    </p>
    <h1
      class="mt-2 text-foreground text-balance"
      style={`font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking);line-height:var(--nb-h1-leading);text-transform:var(--nb-h1-transform)`}
    >
      Manifold
    </h1>
    <p
      class="mt-3 text-[0.9375rem] sm:text-[1.0625rem] text-muted-foreground leading-relaxed text-pretty"
    >
      {config.description}
    </p>
    <div class="mt-3 mb-6 h-px w-full bg-border" role="none"></div>
  </Fragment>

  <div class="space-y-10">
    <section>
      <h2
        class="text-foreground"
        style={`font-size:var(--nb-h2-size);font-weight:var(--nb-h2-weight);letter-spacing:var(--nb-h2-tracking);line-height:var(--nb-h2-leading);text-transform:var(--nb-h2-transform)`}
      >
        Source repository
      </h2>
      <p class="mt-3 leading-7 text-muted-foreground">
        Add this URL in Paperback under
        <strong class="font-medium text-foreground"
          >Settings → Extensions → Add repository</strong
        >. Full install steps are on the
        <a href={`${baseUrl}paperback/`} class="text-primary no-underline hover:underline"
          >Paperback</a
        > page.
      </p>
      <Code code={sourceRepoUrl} lang="text" />
    </section>

    <section class="grid gap-6 sm:grid-cols-2">
      <div>
        <h2
          class="text-foreground"
          style={`font-size:var(--nb-h2-size);font-weight:var(--nb-h2-weight);letter-spacing:var(--nb-h2-tracking);line-height:var(--nb-h2-leading);text-transform:var(--nb-h2-transform)`}
        >
          Guides
        </h2>
        <ul class="mt-3 space-y-2 leading-7 text-muted-foreground">
          <li>
            <a href={`${baseUrl}architecture/`} class="text-primary no-underline hover:underline"
              >Architecture</a
            > — Workers, paths, production-only stack
          </li>
          <li>
            <a href={`${baseUrl}auth/`} class="text-primary no-underline hover:underline">Auth</a>
            — OAuth, DO tokens, device-local Comix
          </li>
          <li>
            <a href={`${baseUrl}development/`} class="text-primary no-underline hover:underline"
              >Development</a
            > — install, test, deploy
          </li>
        </ul>
      </div>
      <div>
        <h2
          class="text-foreground"
          style={`font-size:var(--nb-h2-size);font-weight:var(--nb-h2-weight);letter-spacing:var(--nb-h2-tracking);line-height:var(--nb-h2-leading);text-transform:var(--nb-h2-transform)`}
        >
          CLI
        </h2>
        <p class="mt-3 leading-7 text-muted-foreground">
          Migrations, wipe, prefills, ops triage, and registry maintenance.
        </p>
        <a
          href={`${baseUrl}cli/`}
          class="mt-4 inline-flex font-medium text-primary no-underline hover:underline"
        >
          Browse the CLI docs →
        </a>
      </div>
    </section>
  </div>
</DocsLayout>

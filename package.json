{
  "name": "manifold",
  "private": true,
  "license": "SEE LICENSE IN ATTRIBUTIONS.md",
  "workspaces": {
    "packages": [
      "iac",
      "admin",
      "api",
      "cli",
      "docs",
      "router",
      "packages/*",
      "tracker"
    ],
    "catalogs": {
      "effect": {
        "effect": "4.1.2",
        "@effect/platform-bun": "4.1.2",
        "@effect/platform-node": "4.1.2"
      },
      "cloudflare": {
        "@cloudflare/vite-plugin": "1.67.0",
        "@cloudflare/workers-types": "5.20261104.1",
        "hono": "4.13.16",
        "wrangler": "4.157.0"
      },
      "build": {
        "oxlint": "1.91.0",
        "oxlint-tsgolint": "7.0.2005",
        "@oxlint/plugins": "1.91.0",
        "tsrs": "0.21.0-ts7.1.0-beta",
        "typescript": "7.0.2",
        "oxfmt": "0.76.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vitest": "5.1.0"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.4",
        "tailwindcss": "4.3.4"
      },
      "types": {
        "bun-types": "1.4.4",
        "@types/node": "26.6.6"
      },
      "paperback": {
        "@paperback/toolchain": "1.0.0-alpha.91",
        "@paperback/types": "1.0.0-alpha.92",
        "realm": "20.2.0"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.2",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "backup": "bun api/scripts/backup.ts",
    "build:catalog": "bun scripts/build-catalog.ts",
    "check": "bun run lint:global && bun run typecheck:global",
    "check:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac check",
    "deploy": "bun run build:catalog && bun run --cwd iac deploy",
    "deploy:api": "bun run deploy",
    "destroy": "bun run --cwd iac destroy",
    "destroy:api": "bun run destroy",
    "format:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac format",
    "inspect:realm": "node scripts/inspect-paperback-realm.mjs",
    "license:check": "uvx --from 'reuse[charset-normalizer]==6.2.0' reuse lint",
    "lint": "bun run lint:global",
    "lint:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac lint && bun scripts/check-lint-directives.ts && bun run license:check",
    "manifold": "bun run --cwd cli manifold",
    "plan": "bun run build:catalog && bun run --cwd iac plan",
    "plan:api": "bun run plan",
    "prepare": "effect-tsgo patch --typescript --tsrs --oxlint",
    "test": "bun run test:contract && bun run test:json && bun run test:router && bun run test:canonical && bun run test:mangadex && bun run --cwd admin test && bun run --cwd api test && bun run --cwd cli test && bun run test:paperback",
    "test:canonical": "bun run --cwd packages/canonical test",
    "test:contract": "bun run --cwd packages/contract test",
    "test:json": "bun run --cwd packages/json test",
    "test:mangadex": "bun run --cwd packages/mangadex test",
    "test:oauth": "bun run --cwd api test:oauth",
    "test:paperback": "bun run --cwd packages/paperback-runtime test && bun run --cwd tracker test",
    "test:router": "bun run --cwd router test",
    "typecheck:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@oxlint/plugins": "catalog:build",
    "@types/node": "catalog:types",
    "mime": "4.1.2",
    "oxfmt": "catalog:build",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "realm": "catalog:paperback",
    "tsrs": "catalog:build",
    "typescript": "7.0.2"
  }
}

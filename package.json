{
  "name": "manifold",
  "private": true,
  "workspaces": {
    "packages": [
      "iac",
      "admin",
      "api",
      "cli",
      "docs",
      "router",
      "packages/*",
      "tracker"
    ],
    "catalogs": {
      "effect": {
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112"
      },
      "cloudflare": {
        "@cloudflare/vite-plugin": "1.54.2",
        "@cloudflare/workers-types": "5.20260908.1",
        "hono": "4.13.7",
        "wrangler": "4.127.1"
      },
      "build": {
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "@oxlint/plugins": "1.82.0",
        "typescript": "7.0.2",
        "oxfmt": "0.67.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vitest": "5.0.0"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.3",
        "tailwindcss": "4.3.3"
      },
      "types": {
        "bun-types": "1.4.2",
        "@types/node": "26.5.0"
      },
      "paperback": {
        "@paperback/toolchain": "1.0.0-alpha.91",
        "@paperback/types": "1.0.0-alpha.92",
        "realm": "20.2.0"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.0",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint:global && bun run typecheck:global",
    "check:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/mangaupdates --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac check",
    "lint": "bun run lint:global",
    "lint:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/mangaupdates --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac lint",
    "format:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/mangaupdates --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac format",
    "typecheck:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/mangaupdates --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac typecheck",
    "migrate:md2al": "bun run --cwd cli md2al",
    "migrate:al2md": "bun run --cwd cli al2md",
    "anilist:wipe": "bun run --cwd cli anilist:wipe",
    "anilist:pas5": "bun run --cwd cli anilist:pas5",
    "mal:wipe": "bun run --cwd cli mal:wipe",
    "toolbox:ops": "bun run --cwd cli ops",
    "toolbox:reconcile": "bun run --cwd cli reconcile:diff",
    "toolbox:import-al": "bun run --cwd cli registry:import",
    "test": "bun run test:canonical && bun run test:mangadex && bun run --cwd api test && bun run --cwd cli test && bun run test:paperback",
    "test:oauth": "bun run --cwd api test:oauth",
    "test:canonical": "bun run --cwd packages/canonical test",
    "test:mangadex": "bun run --cwd packages/mangadex test",
    "test:paperback": "bun run --cwd packages/paperback-comix test && bun run --cwd packages/paperback-runtime test && bun run --cwd tracker test",
    "build:docs": "bun run --cwd docs build",
    "build:catalog": "bun run --cwd tracker bundle && bun api/scripts/stage-catalog.ts",
    "check:docs": "bun run --cwd docs typecheck",
    "plan": "bun run build:catalog && bun run --cwd iac plan",
    "deploy": "bun run build:catalog && bun run --cwd iac deploy",
    "destroy": "bun run --cwd iac destroy",
    "plan:api": "bun run plan",
    "deploy:api": "bun run deploy",
    "destroy:api": "bun run destroy",
    "backup": "bun api/scripts/backup.ts",
    "inspect:realm": "node scripts/inspect-paperback-realm.mjs",
    "manifold": "bun run --cwd cli manifold"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:build",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "realm": "catalog:paperback",
    "typescript": "catalog:build"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.76": "patches/alchemy@2.0.0-beta.76.patch"
  }
}

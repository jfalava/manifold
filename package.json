{
  "name": "manifold",
  "private": true,
  "license": "SEE LICENSE IN ATTRIBUTIONS.md",
  "workspaces": {
    "packages": [
      "iac",
      "admin",
      "api",
      "cli",
      "docs",
      "router",
      "packages/*",
      "tracker"
    ],
    "catalogs": {
      "effect": {
        "effect": "4.0.0-rc.115",
        "@effect/platform-bun": "4.0.0-rc.115",
        "@effect/platform-node": "4.0.0-rc.115"
      },
      "cloudflare": {
        "@cloudflare/vite-plugin": "1.54.6",
        "@cloudflare/workers-types": "5.20260920.1",
        "hono": "4.13.8",
        "wrangler": "4.130.0"
      },
      "build": {
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "@oxlint/plugins": "1.82.0",
        "typescript": "7.0.2",
        "oxfmt": "0.68.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vitest": "5.0.1"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.3",
        "tailwindcss": "4.3.3"
      },
      "types": {
        "bun-types": "1.4.2",
        "@types/node": "26.6.2"
      },
      "paperback": {
        "@paperback/toolchain": "1.0.0-alpha.91",
        "@paperback/types": "1.0.0-alpha.92",
        "realm": "20.2.0"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.0",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "backup": "bun api/scripts/backup.ts",
    "build:catalog": "bun scripts/build-catalog.ts",
    "check": "bun run lint:global && bun run typecheck:global",
    "check:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac check",
    "deploy": "bun run build:catalog && bun run --cwd iac deploy",
    "deploy:api": "bun run deploy",
    "destroy": "bun run --cwd iac destroy",
    "destroy:api": "bun run destroy",
    "format:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac format",
    "inspect:realm": "node scripts/inspect-paperback-realm.mjs",
    "license:check": "reuse lint",
    "lint": "bun run lint:global",
    "lint:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac lint",
    "manifold": "bun run --cwd cli manifold",
    "plan": "bun run build:catalog && bun run --cwd iac plan",
    "plan:api": "bun run plan",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "bun run test:contract && bun run test:json && bun run test:router && bun run test:canonical && bun run test:mangadex && bun run --cwd api test && bun run --cwd cli test && bun run test:paperback",
    "typecheck:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/contract --filter @manifold/mangadex --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/tracker --filter @manifold/iac typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "catalog:build",
    "@types/node": "catalog:types",
    "mime": "4.1.0",
    "oxfmt": "catalog:build",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "realm": "catalog:paperback",
    "typescript": "7.0.2"
  }
}

{
  "name": "manifold",
  "private": true,
  "workspaces": {
    "packages": [
      "iac",
      "apps/*",
      "packages/*",
      "source",
      "tracker"
    ],
    "catalogs": {
      "effect": {
        "effect": "4.0.0-rc.112",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@effect/platform-node": "4.0.0-rc.112"
      },
      "cloudflare": {
        "@cloudflare/vite-plugin": "1.54.2",
        "@cloudflare/workers-types": "5.20260831.1",
        "@cloudflare/kumo": "2.12.0",
        "hono": "4.13.5",
        "wrangler": "4.127.1"
      },
      "build": {
        "@astrojs/check": "0.9.10",
        "@vitejs/plugin-react": "6.1.1",
        "oxc-transform-react": "0.147.0",
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "@oxlint/plugins": "1.80.0",
        "pagefind": "1.5.2",
        "satteri": "0.10.5",
        "typescript": "7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vite-plus": "0.3.0",
        "vitest": "4.1.11"
      },
      "react": {
        "react": "19.2.8",
        "react-dom": "19.2.8"
      },
      "tanstack": {
        "@tanstack/react-router": "1.170.32",
        "@tanstack/react-start": "1.168.49",
        "@tanstack/react-table": "9.2.4"
      },
      "styling": {
        "@tailwindcss/vite": "4.3.3",
        "clsx": "2.1.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.3"
      },
      "types": {
        "@types/bun": "1.4.0",
        "@types/node": "26.4.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@types/cli-progress": "3.11.6",
        "bun-types": "^1.4.0"
      },
      "docs": {
        "@cloudflare/nimbus-docs": "0.11.0",
        "@iconify-json/ph": "1.2.2",
        "astro": "~7.2.9",
        "astro-og-canvas": "0.13.0",
        "canvaskit-wasm": "0.42.0"
      },
      "cli": {
        "cli-progress": "3.12.0",
        "listr2": "11.0.1",
        "picocolors": "1.1.1"
      },
      "iac": {
        "alchemy": "2.0.0-beta.74"
      },
      "paperback": {
        "@paperback/toolchain": "1.0.0-alpha.91",
        "@paperback/types": "1.0.0-alpha.92",
        "realm": "20.2.0"
      },
      "ui": {
        "@phosphor-icons/react": "2.1.10"
      },
      "fonts": {
        "@fontsource/google-sans-code": "5.3.0",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@fontsource/zilla-slab": "5.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint:global && bun run typecheck:global",
    "check:global": "bun run lint:global && bun run typecheck:global",
    "lint": "bun run lint:global",
    "lint:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/mangadex --filter @manifold/mangaupdates --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/source --filter @manifold/tracker --filter @manifold/iac lint",
    "typecheck:global": "bun run --filter @manifold/admin --filter @manifold/api --filter @manifold/cli --filter @manifold/docs --filter @manifold/router --filter @manifold/json --filter @manifold/canonical --filter @manifold/comix --filter @manifold/mangadex --filter @manifold/mangaupdates --filter @manifold/paperback-comix --filter @manifold/paperback-runtime --filter @manifold/source --filter @manifold/tracker --filter @manifold/iac typecheck",
    "migrate:md2al": "bun run --cwd apps/cli md2al",
    "migrate:al2md": "bun run --cwd apps/cli al2md",
    "migrate:wipe-al": "bun run --cwd apps/cli wipe-al",
    "toolbox:ops": "bun run --cwd apps/cli ops",
    "toolbox:reconcile": "bun run --cwd apps/cli reconcile:diff",
    "toolbox:import-al": "bun run --cwd apps/cli registry:import",
    "test": "bun run test:canonical && bun run test:mangadex && bun run --cwd apps/api test && bun run --cwd apps/cli test && bun run test:paperback",
    "test:oauth": "bun run --cwd apps/api test:oauth",
    "test:canonical": "bun run --cwd packages/canonical test",
    "test:mangadex": "bun run --cwd packages/mangadex test",
    "test:paperback": "bun run --cwd packages/paperback-comix test && bun run --cwd packages/paperback-runtime test && bun run --cwd source test && bun run --cwd tracker test",
    "build:docs": "bun run --cwd apps/docs build",
    "build:catalog": "bun run --cwd source bundle && bun run --cwd tracker bundle && bun apps/api/scripts/stage-catalog.ts",
    "check:docs": "bun run --cwd apps/docs typecheck",
    "plan": "bun run build:catalog && bun run --cwd iac plan",
    "deploy": "bun run build:catalog && bun run --cwd iac deploy",
    "destroy": "bun run --cwd iac destroy",
    "plan:api": "bun run plan",
    "deploy:api": "bun run deploy",
    "destroy:api": "bun run destroy",
    "inspect:realm": "node scripts/inspect-paperback-realm.mjs",
    "manifold": "bun run --cwd apps/cli manifold"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:build",
    "@types/node": "catalog:types",
    "oxlint": "catalog:build",
    "oxlint-tsgolint": "catalog:build",
    "realm": "catalog:paperback",
    "typescript": "catalog:build"
  },
  "packageManager": "bun@1.4.0"
}
